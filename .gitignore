# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# --- venv / tooling ---
.venv/
venv/

# --- tools ---
.pytest_cache/
.hypothesis/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- runtime / local data ---
*.db
*.sqlite
*.sqlite3
.isotope_zero_cache/

# --- Rust (Phase 6 native core) ---
target/
# compiled native extension is a build artifact (maturin develop regenerates it).
# Match at ANY depth so it stays ignored after the prototype is archived under
# prototypes/<version>/isotope_zero/ — not just at the repo root.
**/_native*.so
**/_native*.dylib
**/*.so
**/*.dylib

# --- npm (npm/ launcher package) ---
node_modules/
npm/.npm/
npm/package-lock.json
.npmrc

# --- OS ---
.DS_Store

# --- local-only harness config (not part of the published package) ---
.claude/

# --- pre-existing scaffold repo checked in by hand ---
Isotope Zero/

# --- vendored third-party reference clone (mem0 comparative audit) ---
# A full upstream checkout used only for the MEM0_COMPARATIVE_AUDIT; never
# commit it (99 MB of third-party code). The audit report lives in the repo.
mem0_repo/