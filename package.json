    "logger.ts",
    "keyboard.ts"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/isotope-zero/isotope-zero"
  },
  "license": "MIT",
  "keywords": [
    "memory",
    "agent",
    "llm",
    "embeddings",
    "vector-search",
    "onnx",
    "rag",
    "sqlite"
  ],
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "chalk": "^5.3.0",
    "ink": "^5.2.1",
    "react": "^18.3.1",
    "yoga-layout": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "dev": "tsx bin/izero.js tui",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  }
