{
  "name": "isotope-zero",
  "version": "1.5.0",
  "description": "Sub-millisecond, local-first cognitive memory layer for AI agents — NumPy/BLAS-accelerated hybrid retrieval, Ebbinghaus decay, and knowledge compaction. Ships a premium React/Ink terminal UI plus the `izero` Python CLI bridge.",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./tui/*": "./dist/tui/*.js"
  },
  "type": "module",
  "bin": {
    "izero": "bin/izero.js"
  },
  "files": [
    "bin/",
    "dist/"
  ],
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/isotope-zero/isotope-zero"
  },
  "license": "MIT",
  "keywords": [
    "memory",
    "agent",
    "llm",
    "embeddings",
    "vector-search",
    "onnx",
    "rag",
    "sqlite",
    "tui",
    "ink"
  ],
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "chalk": "^5.3.0",
    "ink": "^5.2.1",
    "react": "^18.3.1",
    "yoga-layout": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "dev": "tsx bin/izero.js tui",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run typecheck && npm run build",
    "test": "node bin/izero.js --version && node bin/izero.js help"
  }
}